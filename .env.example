# Copie ce fichier en .env et renseigne tes vraies clés avant la publication.
# Sans ces valeurs, l'application utilise les identifiants de TEST de Google.

# AdMob : identifiants des blocs d'annonces (console AdMob > Applications > Blocs d'annonces)
VITE_ADMOB_REWARDED_ID=
VITE_ADMOB_INTERSTITIAL_ID=

# RevenueCat : clé publique Android (Project settings > API keys, commence par "goog_")
VITE_REVENUECAT_ANDROID_KEY=
